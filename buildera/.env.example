# --- Database ---
DATABASE_URL="postgresql://buildera:buildera@localhost:5432/buildera"

# --- Session signing (any long random string) ---
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# --- Models (server-side only; leave both empty to use the offline demo planner) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Sandbox: E2B if set, otherwise local Docker, otherwise file-only workspace ---
E2B_API_KEY=""
# SANDBOX_DRIVER="e2b" | "docker" | "local"   (optional override)

# --- Solana (devnet only) ---
SOLANA_RPC="https://api.devnet.solana.com"
# JSON array secret key, e.g. output of `solana-keygen new -o platform.json && cat platform.json`
PLATFORM_KEYPAIR=""

# --- Storage: local ./data by default; set these for S3-compatible storage ---
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Dev conveniences ---
# Show magic links on screen + enable faucet credits. Never enable in production.
DEV_MODE="true"
